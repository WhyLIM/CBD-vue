# 服务器配置
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://your_domain.com

# MySQL数据库配置
# 请根据您的MySQL服务器信息填写以下配置
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# PRS 即时计算配置
# Python 解释器路径（需要安装 prody, numpy, scipy, pandas, networkx, goatools）
# 留空则使用系统默认 python
PYTHON_BIN=python

# STRING-DB 代理地址（可选）
# 部署在出网被 Cloudflare 拦截的服务器（如部分香港云主机）时必填，
# 指向本站 nginx 反代：需在站点伪静态中配置 location /string-db-proxy/ -> https://string-db.org/
# 本地开发或出网正常时留空（默认 https://string-db.org/api）
STRING_BASE=
